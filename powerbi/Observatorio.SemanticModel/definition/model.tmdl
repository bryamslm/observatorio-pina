model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-ES
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Servidor", "BaseDatos", "Año", "Distrito", "País", "Área piña", "Cambio cobertura", "Exportaciones CR", "Exportaciones mundo", "Producción FAO", "Fecha", "Bloque", "Ciclo", "Cosecha", "Labores", "Ventas"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table Año
ref table Distrito
ref table País
ref table 'Área piña'
ref table 'Cambio cobertura'
ref table 'Exportaciones CR'
ref table 'Exportaciones mundo'
ref table 'Producción FAO'
ref table Fecha
ref table Bloque
ref table Ciclo
ref table Cosecha
ref table Labores
ref table Ventas
ref table Medidas
